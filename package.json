{
  "name": "svg-ai-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run format:check",
    "lint:fix": "eslint --fix && npm run format",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "precommit": "lint-staged",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "eval": "node --conditions=react-server --import tsx evals/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "test:browser:fixture": "node --conditions=react-server --import tsx tests/browser/server.mts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.85",
    "@clerk/nextjs": "^7.9.11",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.128",
    "braintrust": "^3.37.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pg": "^8.23.1",
    "prettier": "3.7.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
