# Copy this file to .env.local and set your key there. Never commit a real key.
OPENAI_API_KEY=

# Server-side model selection for initial testing.
OPENAI_MODEL=gpt-4.1-mini

# The same server key also authenticates moderation and the GPT-6 Luna Decisions
# input-policy checker. OPENAI_MODEL controls SVG generation only.

# Optional server-only search for subjects the model does not understand.
TAVILY_API_KEY=

# --braintrust enables eval uploads; app tracking is separately opt-in below.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=svg-ai-agent

# Record signed-in users' generations and feedback in Braintrust production Logs.
BRAINTRUST_TRACKING_ENABLED=false
# Server-only signing secret for feedback ownership (at least 32 characters).
# Generate locally with: openssl rand -hex 32
BRAINTRUST_FEEDBACK_SECRET=

# Optional image-capable judge used only with --judge. Calibrate before trusting scores.
EVAL_JUDGE_MODEL=gpt-4.1-mini

# Clerk authentication: use development keys locally and production keys on Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon PostgreSQL, server-only. Use separate databases/branches for development
# and production. Paste the connection string in .env.local, never in chat.
DATABASE_URL=
